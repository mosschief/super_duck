  <default>
    <default class="open_duck_mini_v2">
      <geom condim="3" contype="1" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.015 1" solimp="0.9 0.95 0.001"/>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>

      <!--
        SteadyWin GIM4305-10 QDD Planetary Actuator (Used in Pupper v3)
        Replaces the 8 load-bearing leg STS3215 servos in the 1.35x scaled Open Duck Mini v2:
          - Ø53 x 33 mm overall (26 mm housing), 150 g with integrated SDC101 FOC CAN driver
          - 10:1 planetary reduction, reflected rotor armature = 0.0038 kg*m^2
          - 1.0 N*m nominal continuous torque, 3.47 N*m peak stall torque
      -->
      <default class="gim4305">
        <joint type="hinge" damping="0.12" frictionloss="0.025" armature="0.0038" limited="true"/>

        <!-- kv raised 1.4 -> 4.0: with kv=1.4 the leg servos acted like an underdamped spring, so a hard wheel-torque
             step (push recovery) made the legs pogo and the tires bounce off the floor, losing all traction.
             The controller lowers it back to 1.4 for the jump thrust (MIT-mode kd scheduling, see
             `ScaledWheeledDuckController.leg_servo_kd`), since damping also resists the fast leg extension. -->
        <position kp="32.0" kv="4.0" forcerange="-3.47 3.47" inheritrange="1"/>
      </default>

      <!-- SteadyWin GIM4305-10 Wheel Hub Motor (Direct Torque Control at Ankle/Foot Assembly) -->
      <default class="gim4305_wheel">
        <joint type="hinge" axis="0 1 0" limited="false" damping="0.05" frictionloss="0.015" armature="0.0038"/>
        <motor ctrlrange="-3.47 3.47" forcerange="-3.47 3.47" gear="1.0"/>
      </default>

      <!-- SteadyWin GIM6010-8: 11 N*m stall / 5 N*m rated, 8:1, 388 g with driver, Ø80 x 44 mm (manual rev1.2).
           Armature from the GB6010 rotor inertia (748 g*cm^2) x 8^2; the GIM6010-8 figure is unpublished.
           Same impedance gains as gim4305; the sim also applies the manual's torque-speed curve
           (simulate_wheeled_duck.py `apply_leg_torque_curve`). -->
      <default class="gim6010">
        <joint type="hinge" damping="0.12" frictionloss="0.04" armature="0.0048" limited="true"/>
        <position kp="32.0" kv="4.0" forcerange="-11.0 11.0" inheritrange="1"/>
      </default>

      <!-- Original Open Duck Mini v2 Feetech STS3215 (BAM Identified Parameters) for 4-DOF Neck/Head -->
      <default class="sts3215">
        <joint type="hinge" damping="0.56" frictionloss="0.068" armature="0.027" limited="true"/>
        <position kp="13.37" kv="0.8" forcerange="-3.23 3.23" inheritrange="1"/>
      </default>

      <!-- 9 g micro servo (SG90/MG90S class, 4.8-6 V): ~0.18 N*m stall, 0.1 s/60 deg. Armature: rotor x ~300:1 gear.
           Range = Open Duck Mini's +/-1 command (1-2 ms PWM). -->
      <default class="micro_servo_9g">
        <joint type="hinge" axis="0 1 0" range="-0.785398 0.785398" damping="0.002" frictionloss="0.002" armature="0.0001" limited="true"/>
        <position kp="0.3" kv="0.008" forcerange="-0.18 0.18" inheritrange="1"/>
      </default>

      <!-- Cast VytaFlex 40 tire, Ø150 x 32 (cad/tires.md; the CAD tire, without its R4 crowned edges) -->
      <default class="wheel_tire">
        <geom type="cylinder" size="0.075 0.016" euler="1.5707963 0 0" material="wheel_tpu" condim="4" friction="1.25 0.008 0.0002" solref="0.012 1" solimp="0.92 0.97 0.001"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      BASE & TRUNK ASSEMBLY (1.35x Scaled from open_duck_mini_v2.xml `base` z=0.22 -> z=0.3395 with 75mm wheels)
      IMU site: the ICM-42688-P package on the Teensy carrier shelf (CAD `imu_icm42688p`), axes = trunk axes
    -->
    <body name="base" pos="0 0 0.3395">
      <freejoint name="floating_base"/>
      <site name="imu" pos="-0.058 0.008 0.04105" size="0.008" rgba="1 0.2 0.2 1"/>
      <body name="trunk_assembly" pos="0 0 0" quat="1 0 0 0" childclass="open_duck_mini_v2">
        <!--
          Inertials from the CAD (export_sim.py): printed PETG at its walls + infill (structural 6 walls / 45 %, shells
          3 walls / 18 %, the rest 4 walls / 30 %), purchased parts at their real masses (cad/purchased_parts.json),
          each motor in the body that holds its stator, + screws and wiring (120 g in the trunk, 15 g in the head).
          Per-part masses: cad/freecad/mass_properties.json.
        -->
        <inertial pos="-0.0227 -0.0000 -0.0224" mass="2.1430" fullinertia="0.00544353 0.00923576 0.00743234 -5.63465e-05 -0.000311088 3.39902e-05"/>

        <!-- CAD geoms: generated by cad/freecad/export_sim.py -->
        <geom name="trunk_assembly__cad_amp" class="visual" type="mesh" mesh="trunk_assembly__cad_amp" material="cad_amp"/>
        <geom name="trunk_assembly__cad_cell" class="visual" type="mesh" mesh="trunk_assembly__cad_cell" material="cad_cell"/>
        <geom name="trunk_assembly__cad_cell_wrap" class="visual" type="mesh" mesh="trunk_assembly__cad_cell_wrap" material="cad_cell_wrap"/>
        <geom name="trunk_assembly__cad_chip" class="visual" type="mesh" mesh="trunk_assembly__cad_chip" material="cad_chip"/>
        <geom name="trunk_assembly__cad_imu" class="visual" type="mesh" mesh="trunk_assembly__cad_imu" material="cad_imu"/>
        <geom name="trunk_assembly__cad_metal" class="visual" type="mesh" mesh="trunk_assembly__cad_metal" material="cad_metal"/>
        <geom name="trunk_assembly__cad_pcb" class="visual" type="mesh" mesh="trunk_assembly__cad_pcb" material="cad_pcb"/>
        <geom name="trunk_assembly__cad_power" class="visual" type="mesh" mesh="trunk_assembly__cad_power" material="cad_power"/>
        <geom name="trunk_assembly__cad_print" class="visual" type="mesh" mesh="trunk_assembly__cad_print" material="cad_print"/>
        <geom name="trunk_assembly__cad_servo" class="visual" type="mesh" mesh="trunk_assembly__cad_servo" material="cad_servo"/>
        <geom name="trunk_assembly__cad_servo_adapter" class="visual" type="mesh" mesh="trunk_assembly__cad_servo_adapter" material="cad_servo_adapter"/>
        <geom name="trunk_assembly__cad_shell" class="visual" type="mesh" mesh="trunk_assembly__cad_shell" material="cad_shell"/>
        <geom name="trunk_shell_collision" class="collision" type="mesh" mesh="trunk_shell_hull"/>
        <geom name="estop_collision" class="collision" type="mesh" mesh="estop_hull"/>
        <geom name="charge_port_collision" class="collision" type="mesh" mesh="charge_port_hull"/>

        <!-- USB nav camera (CAD `usb_nav_cam`), lens behind the front cap, axis 20 deg below horizontal -->
        <camera name="trunk_nav_cam" pos="0.0868103 0 -0.013658" fovy="75" xyaxes="0.0000 -1.0000 0.0000 0.3420 0.0000 0.9397"/>

        <!-- ==================== NECK & HEAD (Open Duck Mini v2, 1:1: body positions and antenna axes from the CAD) ==================== -->
        <body name="neck_pitch_assembly" pos="0.036 0 0.060">
          <joint name="neck_pitch" type="hinge" axis="0 1 0" range="-0.349066 1.13446" class="sts3215"/>
          <inertial pos="0.0000 0.0013 0.0473" mass="0.0763" fullinertia="4.28796e-05 3.232e-05 2.08649e-05 5.72515e-09 1.47854e-08 4.52379e-07"/>

          <!-- CAD geoms: generated by cad/freecad/export_sim.py -->
          <geom name="neck_pitch_assembly__cad_print" class="visual" type="mesh" mesh="neck_pitch_assembly__cad_print" material="cad_print"/>
          <geom name="neck_pitch_assembly__cad_servo" class="visual" type="mesh" mesh="neck_pitch_assembly__cad_servo" material="cad_servo"/>
