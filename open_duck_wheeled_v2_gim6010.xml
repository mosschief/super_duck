    </body>
  </worldbody>

  <!-- ==================== ACTUATORS (8 GIM4305-10 Leg DOFs + 4 STS3215 Head DOFs + 2 GIM4305-10 Wheels) ==================== -->
  <actuator>
    <!-- Left Leg 4 Upper Joints (SteadyWin GIM4305-10 QDD Position/Impedance Control) -->
    <position name="left_hip_yaw" joint="left_hip_yaw" class="gim4305"/>
    <position name="left_hip_roll" joint="left_hip_roll" class="gim4305"/>
    <position name="left_hip_pitch" joint="left_hip_pitch" class="gim6010"/>
    <position name="left_knee" joint="left_knee" class="gim6010"/>

    <!-- Right Leg 4 Upper Joints (SteadyWin GIM4305-10 QDD Position/Impedance Control) -->
    <position name="right_hip_yaw" joint="right_hip_yaw" class="gim4305"/>
    <position name="right_hip_roll" joint="right_hip_roll" class="gim4305"/>
    <position name="right_hip_pitch" joint="right_hip_pitch" class="gim6010"/>
    <position name="right_knee" joint="right_knee" class="gim6010"/>

    <!-- Neck & Head Camera Gimbal Servos (Feetech STS3215) -->
    <position name="neck_pitch" joint="neck_pitch" class="sts3215"/>
    <position name="head_pitch" joint="head_pitch" class="sts3215"/>
    <position name="head_yaw" joint="head_yaw" class="sts3215"/>
    <position name="head_roll" joint="head_roll" class="sts3215"/>

    <!-- Left & Right Wheel Hub Motors (SteadyWin GIM4305-10 Direct Torque Control) -->
    <motor name="left_wheel_motor" joint="left_wheel" class="gim4305_wheel"/>
    <motor name="right_wheel_motor" joint="right_wheel" class="gim4305_wheel"/>
  </actuator>

  <!-- ==================== SENSORS (Exact open_duck_mini_v2 `sensors.xml` Suite + Wheel Odometry) ==================== -->
  <sensor>
    <!-- IMU Sensors from Open Duck Mini v2 `xmls/sensors.xml` -->
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framexaxis objtype="site" objname="imu" name="forwardvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framepos objtype="site" objname="imu" name="position"/>
    <framequat objtype="site" objname="imu" name="orientation"/>

    <!-- Foot / Wheel Site Sensors from Open Duck Mini v2 `xmls/sensors.xml` -->
    <framelinvel objtype="site" objname="right_foot" name="right_foot_global_linvel"/>
    <framelinvel objtype="site" objname="left_foot" name="left_foot_global_linvel"/>
    <framexaxis objtype="site" objname="left_foot" name="left_foot_upvector"/>
    <framexaxis objtype="site" objname="right_foot" name="right_foot_upvector"/>
    <framepos objtype="site" objname="left_foot" name="left_foot_pos"/>
    <framepos objtype="site" objname="right_foot" name="right_foot_pos"/>

    <!-- 14-Bit Magnetic Wheel Encoders (GIM4305-10 SDC101 Feedback) -->
    <jointpos joint="left_wheel" name="left_wheel_pos"/>
    <jointpos joint="right_wheel" name="right_wheel_pos"/>
    <jointvel joint="left_wheel" name="left_wheel_vel"/>
    <jointvel joint="right_wheel" name="right_wheel_vel"/>
  </sensor>

  <!-- ==================== KEYFRAMES (1.35x Scaled Balanced Crouch Posture) ==================== -->
  <keyframe>
    <!--
      With 0.118 m thigh & shin links at hip_pitch = -0.50 rad, knee = +1.00 rad,
      vertical leg drop = 2 * 0.118 * cos(0.50) = 0.2071 m; plus hip offset (0.074 m) and wheel radius (0.075 m)
      -> base z = 0.3561 m places the 75 mm wheels tangent to the z = 0 floor.
    -->
    <key name="home_balanced"
         qpos="0 0 0.3561 1 0 0 0 0.15 -0.15 0 0 0 0 -0.50 1.00 0 0 0 -0.50 1.00 0"
         ctrl="0 0 -0.50 1.00 0 0 -0.50 1.00 0.15 -0.15 0 0 0 0"/>
  </keyframe>
</mujoco>
