<mujoco model="open_duck_mini_v2_scaled_wheeled">
  <!--
    1.35x Scaled & Wheeled Open Duck Mini v2 (BDX Droid Replica)
    Directly based on apirrone/Open_Duck_Mini (`open_duck_mini_v2.xml`):
      - Preserves the exact Open Duck Mini v2 body tree and naming convention:
        `base` -> `trunk_assembly` ->
          * Left leg:  `hip_roll_assembly` -> `left_roll_to_pitch_assembly` -> `knee_and_ankle_assembly`
                       -> `knee_and_ankle_assembly_2` -> `foot_assembly` (driven wheel)
          * Right leg: `hip_roll_assembly_2` -> `right_roll_to_pitch_assembly` -> `knee_and_ankle_assembly_3`
                       -> `knee_and_ankle_assembly_4` -> `foot_assembly_2` (driven wheel)
          * Neck/Head: `neck_pitch_assembly` -> `head_pitch_to_yaw` -> `neck_yaw_assembly` -> `head_assembly`
      - Uniform 1.35x linear scale factor (42 cm -> 56.7 cm tall) so the original Open Duck Mini v2
        shell proportions and aesthetic fit:
          1. Raspberry Pi 5 (86 x 56 x 16 mm) + Active Cooler + 6S 24V Li-Ion pack inside `trunk_assembly`
          2. 8x SteadyWin GIM4305-10 QDD planetary motors (Ø53 x 33 mm, 150 g, ±3.47 N*m) in the 4 upper leg joints per leg
          3. 2x SteadyWin GIM4305-10 QDD hub motors driving 75 mm radius TPU wheels at `foot_assembly` & `foot_assembly_2`
          4. Dual stereo Raspberry Pi Camera Module 3 sensors (`left_eye_cam`, `right_eye_cam`, 70 mm baseline)
             inside the iconic BDX binocular head bezel + 1 downward-angled chest camera (`trunk_nav_cam`)
          5. Open Duck Mini expression package: hinged antennas on 9 g servos (`left/right_antenna`), WS2812B eye
             rings, projector LED (`projector` light), I2S mic + speaker/amp; 6S BMS, fuse, anti-spark switch,
             e-stop; wheel touch sensors (tools/add_expression_hardware.py)
      - Uses the authentic Open Duck Mini v2 material palette (`body_front_material` off-white PLA
        rgba="0.918 0.918 0.918 1" and `foot_bottom_tpu_material` warm charcoal rgba="0.306 0.298 0.278 1").
      - Includes ready-to-uncomment `<mesh scale="1.35 1.35 1.35" .../>` tags if you drop the original
        STL files from `apirrone/Open_Duck_Mini` into an `assets/` folder alongside this XML.
  -->

  <compiler angle="radian" coordinate="local" meshdir="assets" inertiafromgeom="auto" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" iterations="25" ls_iterations="10">
    <flag eulerdamp="disable" warmstart="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.65 0.65 0.68" ambient="0.32 0.34 0.38" specular="0.20 0.20 0.22"/>
    <rgba haze="0.14 0.20 0.28 1"/>
    <global azimuth="145" elevation="-18" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.18 0.26 0.38" rgb2="0.05 0.07 0.11" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.20 0.24 0.30" rgb2="0.15 0.18 0.23" markrgb="0.32 0.38 0.46" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.12"/>

    <!-- Authentic Open Duck Mini v2 Materials from open_duck_mini_v2.xml -->
    <material name="body_front_material" rgba="0.918 0.918 0.918 1" specular="0.25" shininess="0.3"/>
    <material name="foot_bottom_tpu_material" rgba="0.306 0.298 0.278 1" specular="0.20" shininess="0.25"/>
    <material name="bdx_visor_dark" rgba="0.14 0.14 0.15 1" specular="0.50" shininess="0.6"/>
    <material name="gim4305_housing" rgba="0.22 0.24 0.27 1" specular="0.55" shininess="0.65"/>
    <material name="bdx_eye_led" rgba="0.96 0.92 0.78 1" emission="0.75"/>
    <material name="camera_lens" rgba="0.05 0.07 0.10 1" specular="0.90" shininess="0.95"/>
    <material name="estop_red" rgba="0.80 0.08 0.06 1" specular="0.40" shininess="0.5"/>
    <material name="estop_yellow" rgba="0.95 0.78 0.10 1"/>
    <material name="rpi_green" rgba="0.12 0.55 0.28 1"/>
    <material name="wheel_tpu" rgba="0.18 0.18 0.19 1"/>

    <!--
      Optional: Uncomment if using the raw STL meshes from apirrone/Open_Duck_Mini in `assets/`
      <mesh name="body_front" file="body_front.stl" scale="1.35 1.35 1.35"/>
      <mesh name="body_back" file="body_back.stl" scale="1.35 1.35 1.35"/>
      <mesh name="head_body" file="head_body.stl" scale="1.35 1.35 1.35"/>
    -->
  </asset>

  <default>
    <default class="open_duck_mini_v2">
      <geom condim="3" contype="1" conaffinity="1" friction="0.8 0.005 0.0001" solref="0.015 1" solimp="0.9 0.95 0.001"/>

      <default class="visual">
        <geom contype="0" conaffinity="0" group="2"/>
      </default>

      <default class="collision">
        <geom group="3"/>
      </default>

      <!--
        SteadyWin GIM4305-10 QDD Planetary Actuator (Used in Pupper v3)
        Replaces the 8 load-bearing leg STS3215 servos in the 1.35x scaled Open Duck Mini v2:
          - Ø53 x 33 mm overall (26 mm housing), 150 g with integrated SDC101 FOC CAN driver
          - 10:1 planetary reduction, reflected rotor armature = 0.0038 kg*m^2
          - 1.0 N*m nominal continuous torque, 3.47 N*m peak stall torque
      -->
      <default class="gim4305">
        <joint type="hinge" damping="0.12" frictionloss="0.025" armature="0.0038" limited="true"/>
        <!-- kv raised 1.4 -> 4.0: with kv=1.4 the leg servos acted like an underdamped spring, so a hard wheel-torque
             step (push recovery) made the legs pogo and the tires bounce off the floor, losing all traction.
             The controller lowers it back to 1.4 for the jump thrust (MIT-mode kd scheduling, see
             `ScaledWheeledDuckController.leg_servo_kd`), since damping also resists the fast leg extension. -->
        <position kp="32.0" kv="4.0" forcerange="-3.47 3.47" inheritrange="1"/>
      </default>

      <!-- SteadyWin GIM4305-10 Wheel Hub Motor (Direct Torque Control at Ankle/Foot Assembly) -->
      <default class="gim4305_wheel">
        <joint type="hinge" axis="0 1 0" limited="false" damping="0.05" frictionloss="0.015" armature="0.0038"/>
        <motor ctrlrange="-3.47 3.47" forcerange="-3.47 3.47" gear="1.0"/>
      </default>

      <!-- GIM4305-10SHS physical envelope: Ø53 x 33 overall (Ø37 x 1 output step + Ø53 x 26 housing + Ø40 x 6
           driver boss; SteadyWin installation drawing / STEP), visual only. Camera Module 3 standard lens:
           41 deg vertical FOV (the eye cameras' fovy). -->
      <default class="gim4305_canister">
        <geom type="cylinder" size="0.0265 0.0165" material="gim4305_housing" contype="0" conaffinity="0" group="2"/>
      </default>

      <!-- Original Open Duck Mini v2 Feetech STS3215 (BAM Identified Parameters) for 4-DOF Neck/Head -->
      <default class="sts3215">
        <joint type="hinge" damping="0.56" frictionloss="0.068" armature="0.027" limited="true"/>
        <position kp="13.37" kv="0.8" forcerange="-3.23 3.23" inheritrange="1"/>
      </default>

      <!-- 9 g micro servo (SG90/MG90S class, 4.8-6 V): ~0.18 N*m stall, 0.1 s/60 deg. Armature: rotor x ~300:1 gear.
           Range = Open Duck Mini's +/-1 command (1-2 ms PWM). -->
      <default class="micro_servo_9g">
        <joint type="hinge" axis="0 1 0" range="-0.785398 0.785398" damping="0.002" frictionloss="0.002" armature="0.0001" limited="true"/>
        <position kp="0.3" kv="0.008" forcerange="-0.18 0.18" inheritrange="1"/>
      </default>

      <!-- 1.35x Scaled High-Grip TPU Wheel Tire (Radius = 0.075 m, Width = 0.032 m) -->
      <default class="wheel_tire">
        <geom type="cylinder" size="0.075 0.016" euler="1.5707963 0 0" material="wheel_tpu"
              condim="4" friction="1.25 0.008 0.0002" solref="0.012 1" solimp="0.92 0.97 0.001"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      BASE & TRUNK ASSEMBLY (1.35x Scaled from open_duck_mini_v2.xml `base` z=0.22 -> z=0.3395 with 75mm wheels)
      IMU site: the 1.35x-scaled Open Duck Mini position (-0.108 0 0.0675) was outside the trunk shell; moved inside,
      beside the Teensy carrier on the upper rear wall (tools/check_cad_clearances.py packing check)
    -->
    <body name="base" pos="0 0 0.3395">
      <freejoint name="floating_base"/>
      <site name="imu" pos="-0.062 0.008 0.045" size="0.008" rgba="1 0.2 0.2 1"/>

      <body name="trunk_assembly" pos="0 0 0" quat="1 0 0 0" childclass="open_duck_mini_v2">
        <!--
          Scaled trunk mass = 1.050 kg (1.35x PLA shell `body_front` + `body_back` +
          Raspberry Pi 5 [86x56x16 mm] + Active Cooler + 6S 24V Li-Ion pack + BNO055 IMU)
        -->
        <inertial pos="-0.0120 0.0005 -0.0066" mass="1.229" diaginertia="0.00351 0.00427 0.00402"/>
        <!-- speaker_40mm_3w: 18 g (folded into the trunk_assembly inertial above) -->
        <!-- max98357a_i2s_amp: 2 g (folded into the trunk_assembly inertial above) -->
        <geom name="max98357a_i2s_amp" class="visual" type="box" size="0.009 0.0095 0.0015" pos="-0.06 0.035 0.035" material="rpi_green"/>
        <!-- bms_6s_100a: 40 g (folded into the trunk_assembly inertial above) -->
        <geom name="bms_6s_100a" class="visual" type="box" size="0.03 0.004 0.02" pos="-0.026 0.053 -0.026" material="gim4305_housing"/>
        <!-- main_fuse_40a: 10 g (folded into the trunk_assembly inertial above) -->
        <geom name="main_fuse_40a" class="visual" type="box" size="0.012 0.005 0.01" pos="-0.026 -0.053 -0.04" material="foot_bottom_tpu_material"/>
        <!-- antispark_switch_120a: 25 g (folded into the trunk_assembly inertial above) -->
        <geom name="antispark_switch_120a" class="visual" type="box" size="0.02 0.01 0.008" pos="0.033 -0.048 -0.03" material="gim4305_housing"/>
        <!-- peripheral_5v_buck: 10 g (folded into the trunk_assembly inertial above) -->
        <geom name="peripheral_5v_buck" class="visual" type="box" size="0.011 0.008 0.006" pos="0.03 0.048 -0.03" material="rpi_green"/>
        <!-- estop_22mm: 25 g (folded into the trunk_assembly inertial above) -->
        <!-- ai_hat_plus_26tops: 41 g (folded into the trunk inertial above) -->
        <geom name="ai_hat_plus_26tops" class="visual" type="box" size="0.0325 0.0283 0.0028" pos="-0.006 0.0 0.042" material="rpi_green"/>
        <!-- teensy_40_dual_can (PJRC Teensy 4.0 + Dual CAN transceiver carrier + ICM-42688-P IMU): 8 g (folded into the trunk inertial above) -->
        <geom name="teensy_40_dual_can" class="visual" type="box" size="0.0110 0.0210 0.0035" pos="-0.062 -0.03 0.045" material="gim4305_housing"/>

        <!-- 1.35x Scaled Open Duck Mini v2 BDX Trunk Shell (`body_front` & `body_back` geometry) -->
        <geom name="trunk_collision" class="collision" type="box" size="0.074 0.063 0.058" material="body_front_material"/>
        <geom name="body_front_shell" class="visual" type="box" size="0.042 0.062 0.056" pos="0.032 0 0.002" euler="0 0.14 0" material="body_front_material"/>
        <geom name="body_front_curved_breast" class="visual" type="cylinder" size="0.058 0.038" pos="0.040 0 0.004" euler="0 0.14 0" material="body_front_material"/>
        <geom name="body_back_shell" class="visual" type="box" size="0.044 0.060 0.052" pos="-0.034 0 -0.002" euler="0 -0.10 0" material="body_front_material"/>
        <geom name="body_bottom_trim" class="visual" type="box" size="0.066 0.056 0.012" pos="0 0 -0.052" material="foot_bottom_tpu_material"/>
        <geom name="body_neck_socket" class="visual" type="cylinder" size="0.034 0.010" pos="0.036 0 0.056" euler="0 0.15 0" material="foot_bottom_tpu_material"/>

        <!-- Internal Raspberry Pi 5 (86 x 56 x 16 mm) & Low-Slung 6S Battery Pack -->
        <geom name="raspberry_pi_5" class="visual" type="box" size="0.043 0.028 0.008" pos="-0.006 0 0.018" material="rpi_green"/>
        <geom name="battery_pack_6s" class="visual" type="box" size="0.045 0.038 0.015" pos="0.004 0 -0.032" material="foot_bottom_tpu_material"/>
        <geom name="speaker_40mm_3w" class="visual" type="cylinder" size="0.020 0.003" pos="-0.066 0 0.012" euler="0 1.5708 0" material="foot_bottom_tpu_material"/>
        <geom name="estop_bezel" class="visual" type="cylinder" size="0.012 0.004" pos="-0.080 0 0.015" euler="0 1.5708 0" material="estop_yellow"/>
        <geom name="estop_mushroom" class="visual" type="cylinder" size="0.016 0.004" pos="-0.087 0 0.015" euler="0 1.5708 0" material="estop_red"/>

        <!-- Chest Forward-Downward Navigation Camera (Raspberry Pi Camera Module 3 Wide, 25 x 24 x 12.4 mm) -->
        <geom name="chest_cam_bezel" class="visual" type="cylinder" size="0.014 0.005" pos="0.088 0 -0.014" euler="0 1.5708 0" material="foot_bottom_tpu_material"/>
        <geom name="chest_cam_lens" class="visual" type="cylinder" size="0.009 0.006" pos="0.090 0 -0.014" euler="0 1.5708 0" material="camera_lens"/>
        <camera name="trunk_nav_cam" pos="0.093 0 -0.014" euler="0 -1.22 -1.5708" fovy="75"/>

        <!-- ==================== NECK & HEAD CHAIN (Exact open_duck_mini_v2 Hierarchy, 1.35x Scaled) ==================== -->
        <body name="neck_pitch_assembly" pos="0.036 0 0.060">
          <joint name="neck_pitch" type="hinge" axis="0 1 0" range="-0.349066 1.13446" class="sts3215"/>
          <inertial pos="0 0 0.028" mass="0.085" diaginertia="0.00006 0.00006 0.00003"/>
          <geom name="neck_pitch_link" class="visual" type="box" size="0.018 0.022 0.030" pos="0 0 0.028" material="foot_bottom_tpu_material"/>

          <body name="head_pitch_to_yaw" pos="0 0 0.058">
            <joint name="head_pitch" type="hinge" axis="0 1 0" range="-0.785398 0.785398" class="sts3215"/>
            <inertial pos="0 0 0.012" mass="0.030" diaginertia="0.00002 0.00002 0.000015"/>
            <geom name="head_pitch_bracket" class="visual" type="box" size="0.022 0.024 0.014" material="foot_bottom_tpu_material"/>

            <body name="neck_yaw_assembly" pos="0 0 0.022">
              <joint name="head_yaw" type="hinge" axis="0 0 1" range="-2.79253 2.79253" class="sts3215"/>
              <inertial pos="0 0 0.015" mass="0.110" diaginertia="0.00007 0.00007 0.00005"/>
              <geom name="neck_yaw_housing" class="visual" type="cylinder" size="0.024 0.016" material="foot_bottom_tpu_material"/>

              <!--
                1.35x Scaled Open Duck Mini v2 BDX Binocular-Trapezoid Head (`head_assembly`)
                Matches the signature flat-browed, boxy-trapezoidal BDX head from apirrone/Open_Duck_Mini:
                  - Off-white PLA trapezoidal outer hood (`body_front_material`)
                  - Recessed charcoal front visor cavity (`foot_bottom_tpu_material`)
                  - Iconic BDX binocular camera/LED eye bezels housing stereo Raspberry Pi Camera Module 3 units
                  - Twin rear antenna stalks driven by micro servos
              -->
              <body name="head_assembly" pos="0.010 0 0.038">
                <joint name="head_roll" type="hinge" axis="1 0 0" range="-0.523599 0.523599" class="sts3215"/>
                <inertial pos="0.0095 0.0000 0.0053" mass="0.511" diaginertia="0.00073 0.00088 0.00098"/>
                <!-- left_antenna_servo_9g: 9 g (folded into the head_assembly inertial above) -->
                <geom name="left_antenna_servo_9g" class="visual" type="box" size="0.0115 0.006 0.0145" pos="-0.032 0.046 0.02" material="gim4305_housing"/>
                <!-- right_antenna_servo_9g: 9 g (folded into the head_assembly inertial above) -->
                <geom name="right_antenna_servo_9g" class="visual" type="box" size="0.0115 0.006 0.0145" pos="-0.032 -0.046 0.02" material="gim4305_housing"/>
                <!-- left_eye_ws2812_ring: 2 g (folded into the head_assembly inertial above) -->
                <!-- right_eye_ws2812_ring: 2 g (folded into the head_assembly inertial above) -->
                <!-- projector_led_reflector: 6 g (folded into the head_assembly inertial above) -->
                <!-- microphone_inmp441: 2 g (folded into the head_assembly inertial above) -->
                <geom name="microphone_inmp441" class="visual" type="box" size="0.007 0.007 0.001" pos="0.03 0.0 0.032" material="rpi_green"/>

                <!-- Inner Collision Box -->
                <geom name="head_collision" class="collision" type="box" size="0.052 0.068 0.036" material="body_front_material"/>

                <!-- BDX Trapezoidal Outer Shell (Off-White PLA `body_front_material`) -->
                <geom name="head_core_shell" class="visual" type="box" size="0.050 0.060 0.034" material="body_front_material"/>
                <!-- Wide Flat Overhanging Top Brow Plate (156 mm wide x 112 mm deep) -->
                <geom name="head_top_brow" class="visual" type="box" size="0.056 0.078 0.006" pos="0.004 0 0.035" euler="0 0.05 0" material="body_front_material"/>
                <!-- Narrower Flat Bottom Jaw Plate (124 mm wide) -->
                <geom name="head_bottom_jaw" class="visual" type="box" size="0.048 0.062 0.006" pos="0.002 0 -0.035" material="body_front_material"/>
                <!-- Inward-Slanted Trapezoidal Left & Right Side Walls -->
                <geom name="head_left_trapezoid_cheek" class="visual" type="box" size="0.052 0.007 0.036" pos="0.002 0.068 0.001" euler="-0.24 0 -0.06" material="body_front_material"/>
                <geom name="head_right_trapezoid_cheek" class="visual" type="box" size="0.052 0.007 0.036" pos="0.002 -0.068 0.001" euler="0.24 0 0.06" material="body_front_material"/>
                <!-- Slanted Rear Head Backplate -->
                <geom name="head_back_plate" class="visual" type="box" size="0.008 0.062 0.033" pos="-0.048 0 0.001" euler="0 -0.18 0" material="foot_bottom_tpu_material"/>

                <!-- Recessed Dark Charcoal BDX Face Cavity -->
                <geom name="head_face_recess" class="visual" type="box" size="0.006 0.064 0.028" pos="0.048 0 0.000" material="bdx_visor_dark"/>

                <!--
                  Iconic BDX Asymmetric/Binocular LED Eye Bezels + Stereo Raspberry Pi Camera Module 3 Units
                  (70 mm Stereo Baseline in the 1.35x Scaled Head)
                -->
                <!-- Left Eye Binocular Barrel (Slightly Larger BDX Primary Scope) -->
                <geom name="left_eye_housing" class="visual" type="cylinder" size="0.024 0.008" pos="0.052 0.035 0.002" euler="0 1.5708 0" material="foot_bottom_tpu_material"/>
                <geom name="left_eye_led_ring" class="visual" type="cylinder" size="0.019 0.0085" pos="0.053 0.035 0.002" euler="0 1.5708 0" material="bdx_eye_led"/>
                <geom name="left_eye_cam_lens" class="visual" type="cylinder" size="0.012 0.009" pos="0.054 0.035 0.002" euler="0 1.5708 0" material="camera_lens"/>
                <geom name="left_rpi_cam3_pcb" class="visual" type="box" size="0.0058 0.0125 0.012" pos="0.042 0.035 0.002" material="rpi_green"/>
                <camera name="left_eye_cam" pos="0.058 0.035 0.002" euler="0 -1.5708 -1.5708" fovy="41"/>

                <!-- Right Eye Binocular Barrel (BDX Secondary Scope) -->
                <geom name="right_eye_housing" class="visual" type="cylinder" size="0.021 0.008" pos="0.052 -0.035 0.002" euler="0 1.5708 0" material="foot_bottom_tpu_material"/>
                <geom name="right_eye_led_ring" class="visual" type="cylinder" size="0.016 0.0085" pos="0.053 -0.035 0.002" euler="0 1.5708 0" material="bdx_eye_led"/>
                <geom name="right_eye_cam_lens" class="visual" type="cylinder" size="0.010 0.009" pos="0.054 -0.035 0.002" euler="0 1.5708 0" material="camera_lens"/>
                <geom name="right_rpi_cam3_pcb" class="visual" type="box" size="0.0058 0.0125 0.012" pos="0.042 -0.035 0.002" material="rpi_green"/>
                <geom name="projector_lens" class="visual" type="cylinder" size="0.007 0.003" pos="0.055 0 -0.018" euler="0 1.5708 0" material="bdx_eye_led"/>
                <light name="projector" pos="0.059 0 -0.018" dir="1 0 -0.25" cutoff="20" exponent="8" diffuse="0.9 0.85 0.7" specular="0.2 0.2 0.2" castshadow="false" active="false"/>
                <camera name="right_eye_cam" pos="0.058 -0.035 0.002" euler="0 -1.5708 -1.5708" fovy="41"/>

                <!-- BDX Twin Rear Antenna Ears, each swung fore/aft by a 9 g micro servo (servo bodies folded into the
                     head inertial above; Open Duck Mini `antennas.py`: 1-2 ms PWM = +/-45 deg) -->
                <body name="left_antenna" pos="-0.032 0.046 0.038">
                  <joint name="left_antenna" class="micro_servo_9g"/>
                  <inertial pos="-0.007 0.004 0.032" mass="0.003" diaginertia="0.0000009 0.0000009 0.0000001"/>
                  <geom name="left_antenna_base" class="visual" type="cylinder" size="0.008 0.008" material="foot_bottom_tpu_material"/>
                  <geom name="left_antenna_stalk" class="visual" type="capsule" fromto="0 0 0.004 -0.014 0.008 0.060" size="0.0035" material="foot_bottom_tpu_material"/>
                </body>
                <body name="right_antenna" pos="-0.032 -0.046 0.038">
                  <joint name="right_antenna" class="micro_servo_9g"/>
                  <inertial pos="-0.007 -0.004 0.032" mass="0.003" diaginertia="0.0000009 0.0000009 0.0000001"/>
                  <geom name="right_antenna_base" class="visual" type="cylinder" size="0.008 0.008" material="foot_bottom_tpu_material"/>
                  <geom name="right_antenna_stalk" class="visual" type="capsule" fromto="0 0 0.004 -0.014 -0.008 0.060" size="0.0035" material="foot_bottom_tpu_material"/>
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- ==================== LEFT LEG CHAIN (Exact open_duck_mini_v2 Hierarchy + 4 GIM4305 Joints + Wheel) ==================== -->
        <body name="hip_roll_assembly" pos="0 0.084 -0.044">
          <joint name="left_hip_yaw" type="hinge" axis="0 0 1" range="-0.5235987755982979 0.5235987755982997" class="gim4305"/>
          <inertial pos="0 0 -0.012" mass="0.180" diaginertia="0.00009 0.00009 0.00008"/>
          <geom name="left_hip_yaw_gim4305" class="gim4305_canister" pos="0 0 0"/>
          <geom name="left_hip_yaw_bracket" class="visual" type="box" size="0.028 0.026 0.018" pos="0 0 -0.016" material="body_front_material"/>

          <body name="left_roll_to_pitch_assembly" pos="0 0.018 -0.030">
            <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-0.436332 0.436332" class="gim4305"/>
            <inertial pos="0 0.014 0" mass="0.185" diaginertia="0.00009 0.00010 0.00009"/>
